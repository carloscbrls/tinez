---
import Layout from "../layouts/Layout.astro";
import { teams } from "../data/teams";
import { teamRosters, getKeeperSummary } from "../data/keepers";
---

<Layout title="Keepers">
  <div class="mb-8">
    <div class="relative overflow-hidden rounded-2xl border border-amber-500/20">
      <div class="hero-gradient absolute inset-0 animate-gradient"></div>
      <div class="relative z-10 p-8">
        <div class="flex items-center gap-3 mb-2">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 text-lg font-bold text-white shadow-lg shadow-amber-500/20">🔄</div>
          <div>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">
              <span class="gradient-text">Keeper Tracker</span>
            </h1>
            <p class="text-zinc-400 text-sm mt-0.5">TINEZ LEAGUE · 2026 Season · Keeper (1+1) Format</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2025 Final Standings -->
  <div class="glass-card-accent rounded-xl p-5 mb-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-lg">🏆</span>
      <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider">2025 Season Results</h2>
    </div>
    <div class="grid gap-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="text-yellow-400">🥇</span>
        <span class="text-zinc-200 font-semibold">Best Pacheco Hoe</span>
        <span class="text-zinc-500">(jayyphilly) — Champion</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-zinc-400">🥈</span>
        <span class="text-zinc-200 font-semibold">The Red Hare & Golden Dragon</span>
        <span class="text-zinc-500">(darnell) — 2nd Place</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-amber-700">🥉</span>
        <span class="text-zinc-200 font-semibold">LaFlamaBlanca</span>
        <span class="text-zinc-500">(scooter) — 3rd Place</span>
      </div>
    </div>
  </div>

  <!-- Keeper Rules (from Tinez Constitution, Articles XVI + XXI) -->
  <div class="glass-card-accent rounded-xl p-5 mb-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-lg">📋</span>
      <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider">
        Keeper Rules
        <span class="text-[10px] text-zinc-500 normal-case font-normal ml-2">
          from Constitution Art. XVI &amp; XXI
        </span>
      </h2>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 text-xs text-zinc-400">
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Each team keeps <strong class="text-zinc-200">1 offensive + 1 defensive</strong> player</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Keepers must be on roster by <strong class="text-zinc-200">Week 8</strong></span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>A player <strong class="text-zinc-200">can only be kept for 1 season</strong> before returning to pool</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Deadline: <strong class="text-zinc-200">24 hours before the draft</strong></span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span><strong class="text-zinc-200">New team owners</strong> may keep any player on their roster, including ones kept by previous owners</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Players from <strong class="text-zinc-200">Rounds 21 &amp; 22</strong> of the previous draft are <strong class="text-zinc-200">not eligible</strong> to be kept</span>
      </div>
      <div class="flex items-start gap-2 sm:col-span-2">
        <span class="text-amber-400 mt-0.5">★</span>
        <span><strong class="text-zinc-200">House rule (cost):</strong> every keeper costs their <strong class="text-zinc-200">last-round pick</strong> of the draft (Rd 22 for the 2026 draft), regardless of when they were originally drafted.</span>
      </div>
    </div>
    <p class="text-[10px] text-zinc-600 mt-3">
      See <a href="/constitution" class="text-amber-400/80 hover:text-amber-400 underline">full constitution</a> for Articles XVI &amp; XXI in context.
    </p>
  </div>

  <!-- Team Keeper Cards -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 stagger-children" id="keepers-grid">
    {teamRosters.map((roster, idx) => {
      const { kept } = getKeeperSummary(roster.teamName);
      return (
        <div class="glass-card rounded-xl overflow-hidden" data-team-name={roster.teamName}>
          <div class="bg-gradient-to-r from-amber-500/10 to-orange-500/5 p-4 border-b border-zinc-800/40">
            <h3 class="text-sm font-bold text-zinc-100">{roster.teamName}</h3>
            <p class="text-[10px] text-zinc-500">{roster.manager}</p>
          </div>
          <div class="p-4">
            <!-- Previously Kept Players (static, from 2025 final rosters) -->
            {kept.length > 0 && (
              <div class="mb-3">
                <h4 class="text-[10px] font-semibold text-amber-400 uppercase tracking-wider mb-2">Previously Kept (2025)</h4>
                <div class="space-y-1.5">
                  {kept.map(p => (
                    <div class="flex items-center justify-between bg-amber-500/5 rounded-lg px-2.5 py-1.5">
                      <div class="flex items-center gap-1.5">
                        <span class="text-xs">🔒</span>
                        <span class="text-xs font-medium text-zinc-200">{p.name}</span>
                        <span class="text-[10px] text-zinc-500">{p.position} · {p.nflTeam}</span>
                      </div>
                      <span class="text-[10px] text-amber-400 font-mono">Rd {p.draftRound}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {kept.length === 0 && (
              <div class="text-center py-4">
                <p class="text-xs text-zinc-600">No locks from 2025</p>
              </div>
            )}

            <!-- Live Keeper Eligibility (Yahoo draft + roster, computed client-side) -->
            <div data-eligible-slot={idx}>
              <h4 class="text-[10px] font-semibold text-emerald-400 uppercase tracking-wider mb-2 mt-1">
                Keeper Eligible · 2026 <span class="text-zinc-600 normal-case font-normal">(live from Yahoo)</span>
              </h4>
              <div class="space-y-1 max-h-48 overflow-y-auto" data-eligible-list>
                <!-- Skeleton while loading -->
                <div data-eligible-loading class="space-y-1">
                  <div class="h-4 bg-zinc-800/50 rounded animate-pulse"></div>
                  <div class="h-4 bg-zinc-800/50 rounded animate-pulse w-11/12"></div>
                  <div class="h-4 bg-zinc-800/50 rounded animate-pulse w-10/12"></div>
                </div>
              </div>
              <!-- Error/Auth state gets injected here by the script -->
              <div data-eligible-error class="hidden"></div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Live data status footer -->
  <div id="keepers-live-status" class="mt-4 flex items-center justify-end gap-2 text-[10px] text-zinc-600">
    <span class="h-1.5 w-1.5 rounded-full bg-zinc-700" id="keepers-live-dot"></span>
    <span id="keepers-live-label">Live data idle</span>
  </div>

  <!-- Client-side Yahoo draft + roster fetch (keeper eligibility logic) -->
  <script>
    import { checkAuth, getLeagues, getRosters, getDraftResults, YahooAuthError, YahooRateLimitError } from "../data/yahoo-api";

    // Tinez league — if /leagues lookup fails we fall back to this hardcoded key.
    const TINEZ_LEAGUE_ID = "541137";
    const TINEZ_LEAGUE_KEY = "449.l.541137";
    // The season whose draft we're using to determine 2026 keeper eligibility.
    // Each pick in SEASON's draft is annotated with keeper_status, telling us
    // whether the player was itself a keeper from the prior year.
    const ELIGIBILITY_SEASON = 2025;
    const SESSION_TTL_MS = 5 * 60 * 1000;
    // House rule (not in constitution): every keeper costs their last-round
    // pick of the whole draft. For the 2026 draft that's Rd 22. If the draft
    // length ever changes, update this constant.
    const LAST_ROUND_PICK = 22;

    type EligiblePlayer = {
      name: string;
      position: string;
      nflTeam: string;
      draftRound: number;       // round drafted in 2025
      /** Cost to keep in 2026 per the house rule: every keeper costs their
       *  last-round pick of the whole draft (= Rd 22 for the 2026 draft). */
      newCost: number;
      isLockedAlready: boolean; // already kept from 2024 into 2025 (Yahoo says)
      side: "O" | "D";          // offensive or defensive — per Article XVI
    };
    type LiveTeam = {
      teamName: string;
      eligible: EligiblePlayer[];
    };

    function setStatus(text: string, dot: "idle" | "loading" | "ok" | "err" = "idle") {
      const label = document.getElementById("keepers-live-label");
      const dotEl = document.getElementById("keepers-live-dot");
      if (label) label.textContent = text;
      if (dotEl) {
        dotEl.className =
          "h-1.5 w-1.5 rounded-full " +
          (dot === "ok" ? "bg-emerald-400" :
           dot === "loading" ? "bg-amber-400 animate-pulse" :
           dot === "err" ? "bg-red-400" : "bg-zinc-700");
      }
    }

    type CachedData = { teams: LiveTeam[]; ts: number };
    function getCached(): CachedData | null {
      try {
        const raw = sessionStorage.getItem("tinez:keepers:v4");
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed?.ts || !parsed?.teams) return null;
        if (Date.now() - parsed.ts > SESSION_TTL_MS) return null;
        return parsed as CachedData;
      } catch { return null; }
    }
    function setCached(teams: LiveTeam[]) {
      try {
        sessionStorage.setItem("tinez:keepers:v4", JSON.stringify({ ts: Date.now(), teams }));
      } catch {}
    }

    function secondsAgo(ts: number): number {
      return Math.max(0, Math.round((Date.now() - ts) / 1000));
    }

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, c => (
        { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!
      ));
    }

    function playerRowHtml(p: EligiblePlayer): string {
      // Article XVI: 1 offensive + 1 defensive keeper per team. Yahoo's
      // keeper_status tells us if they were already kept from 2024 into
      // 2025 — those can't be re-kept (1-season max). Show those greyed.
      const lockIcon = p.isLockedAlready ? "🔒" : "🔓";
      const rowClass = p.isLockedAlready
        ? "flex items-center justify-between px-2.5 py-1 rounded-lg opacity-60"
        : "flex items-center justify-between px-2.5 py-1 hover:bg-zinc-800/30 rounded-lg transition-colors";
      const sideBadgeColor = p.side === "O" ? "text-amber-400" : "text-sky-400";
      return `
        <div class="${rowClass}">
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-xs shrink-0">${lockIcon}</span>
            <span class="text-[9px] font-mono ${sideBadgeColor} shrink-0">${p.side}</span>
            <span class="text-xs text-zinc-200 truncate">${escapeHtml(p.name)}</span>
            <span class="text-[10px] text-zinc-500 shrink-0">${escapeHtml(p.position)} · ${escapeHtml(p.nflTeam)}</span>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="text-[10px] text-zinc-600 font-mono">Rd ${p.draftRound}</span>
            <span class="text-[10px] ${p.isLockedAlready ? "text-zinc-600" : "text-emerald-400"} font-mono">→ Rd ${p.newCost}</span>
          </div>
        </div>`;
    }

    function renderTeamsInto(teams: LiveTeam[]) {
      const cards = document.querySelectorAll<HTMLElement>("[data-team-name]");
      let matched = 0;
      cards.forEach(card => {
        const teamName = card.dataset.teamName || "";
        const slot = card.querySelector<HTMLElement>("[data-eligible-list]");
        if (!slot) return;
        // Try exact match first, then fuzzy (Yahoo team_name sometimes has
        // "(...)" suffixes from the manager name).
        let team = teams.find(t => t.teamName === teamName);
        if (!team) team = teams.find(t => t.teamName.startsWith(teamName));
        if (!team) {
          slot.innerHTML = `<p class="text-[10px] text-zinc-600 py-2">No 2025 draft data for this team.</p>`;
          return;
        }
        matched++;
        if (team.eligible.length === 0) {
          slot.innerHTML = `<p class="text-[10px] text-zinc-600 py-2">No eligible keepers for 2026 (all 2025 picks were either round 1–3 or already 2-year locked).</p>`;
          return;
        }
        slot.innerHTML = team.eligible.map(playerRowHtml).join("");
      });
      return matched;
    }

    function renderAuthError() {
      const slots = document.querySelectorAll<HTMLElement>("[data-eligible-list]");
      slots.forEach(s => {
        s.innerHTML = `
          <div class="text-center py-4">
            <p class="text-xs text-zinc-400 mb-2">Connect Yahoo to see live keeper eligibility.</p>
            <a href="/connect-yahoo" class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-br from-amber-400 to-orange-500 px-3 py-1.5 text-xs font-semibold text-white shadow-lg shadow-amber-500/20 hover:scale-105 transition-transform">
              Connect Yahoo →
            </a>
          </div>`;
      });
      document.querySelectorAll<HTMLElement>("[data-eligible-loading]").forEach(el => el.remove());
    }

    function renderGenericError(msg: string) {
      const slots = document.querySelectorAll<HTMLElement>("[data-eligible-list]");
      slots.forEach(s => {
        s.innerHTML = `
          <div class="text-center py-3">
            <p class="text-xs text-zinc-500">⚠️ ${escapeHtml(msg)}</p>
            <button data-retry class="mt-2 text-[10px] text-amber-400 hover:text-amber-300 underline">Retry</button>
          </div>`;
      });
      document.querySelectorAll<HTMLElement>("[data-eligible-loading]").forEach(el => el.remove());
      document.querySelectorAll<HTMLElement>("[data-retry]").forEach(b => b.addEventListener("click", () => run()));
    }

    async function resolveLeagueKey(): Promise<string> {
      try {
        const leagues = await getLeagues();
        const match = leagues.find(l => l.league_id === TINEZ_LEAGUE_ID);
        if (match?.league_key) return match.league_key;
      } catch {}
      return TINEZ_LEAGUE_KEY;
    }

    // ─── Keeper eligibility engine ────────────────────────────────────────
    // Inputs:
    //   drafts: YahooDraftResult[] — full 2025 draft, each pick has
    //           { round, cost, keeper, keeper_status, player_key, team_key, ... }
    //   rosters: YahooRoster[] — current 2025 rosters, each with team_name
    //            and players[] with player_keys.
    //
    // Rules per the Tinez Constitution (Articles XVI + XXI):
    //   1. Each team keeps 1 offensive + 1 defensive player. (Position-based
    //      split — offensive = QB/RB/WR/TE/K, defensive = DL/LB/DB/IDP. We
    //      tag each pick with its side and only show O-side here since K is
    //      treated as offense in this league's convention; commissioner
    //      picks the split per team.)
    //   2. Players from Rounds 21 & 22 of the 2025 draft are NOT eligible.
    //      (Article XXI clarification.)
    //   3. A player can only be kept for 1 season. Constitution has no cost
    //      formula — we display "Rnd X → Rnd X" (no inflation) to be
    //      honest about the fact that cost math isn't codified.
    //   4. Yahoo's keeper_status 'kept' / 'uneligible' → ineligible to keep
    //      again (already kept from 2024 into 2025).
    //   5. Traded/cut picks → filtered out (can't keep what you don't own).
    //   6. New team owners (we can't detect this server-side; flagged in the
    //      rules section above) may keep anyone on their roster.
    function positionSide(position: string): "O" | "D" {
      const d = (position || "").toUpperCase();
      if (d === "QB" || d === "RB" || d === "WR" || d === "TE" || d === "K") return "O";
      return "D"; // DL, LB, DB, S, CB, DT, DE, IDP
    }

    function buildKeeperEligibility(
      drafts: any[],
      rosters: any[]
    ): LiveTeam[] {
      // Build a set of player_keys currently on each team's roster.
      const rosterByTeam = new Map<string, Set<string>>();
      for (const r of rosters) {
        const teamName = r.team_name || "";
        const keys = new Set<string>();
        for (const p of (r.players || [])) {
          if (p.player_key) keys.add(p.player_key);
        }
        rosterByTeam.set(teamName, keys);
      }

      // Group all 2025 picks by team_name.
      const teamMap = new Map<string, { eligible: EligiblePlayer[] }>();
      for (const pick of drafts) {
        const teamName = pick.team_name || "";
        if (!teamName) continue;
        if (!teamMap.has(teamName)) {
          teamMap.set(teamName, { eligible: [] });
        }
        const entry = teamMap.get(teamName)!;

        // Filter out picks the team doesn't currently roster (cut, traded away).
        const rk = rosterByTeam.get(teamName);
        if (rk && !rk.has(pick.player_key)) continue;

        // Article XXI: Rounds 21 & 22 are not eligible.
        if (pick.round >= 21) continue;

        // Article XVI: a player can only be kept for 1 season. Yahoo signals
        // they were already kept from 2024 into 2025 with keeper_status
        // 'kept' / 'uneligible'. Those players can't be kept again.
        const alreadyKept =
          pick.keeper_status === "kept" ||
          pick.keeper_status === "uneligible" ||
          pick.keeper_status === "ineligible" ||
          pick.keeper === true;

        entry.eligible.push({
          name: pick.player_name || "",
          position: pick.position || "",
          nflTeam: pick.nfl_team || "",
          draftRound: pick.round,
          // House rule: every keeper costs the last-round pick (= 22).
          // Their 2025 draft round is irrelevant for cost — we show it as
          // context only.
          newCost: LAST_ROUND_PICK,
          isLockedAlready: alreadyKept,
          side: positionSide(pick.position || ""),
        });
      }

      // Sort: best value first (late round steals that became starters).
      const out: LiveTeam[] = [];
      teamMap.forEach((entry, teamName) => {
        entry.eligible.sort((a, b) => b.draftRound - a.draftRound);
        out.push({ teamName, eligible: entry.eligible });
      });
      return out;
    }

    async function run() {
      const cards = document.querySelectorAll("[data-team-name]");
      if (cards.length === 0) return;

      // 1. Auth check
      try {
        const auth = await checkAuth();
        if (!auth.authenticated) {
          setStatus("Yahoo not connected", "err");
          renderAuthError();
          return;
        }
      } catch {
        setStatus("Yahoo status check failed", "err");
        renderGenericError("Couldn't reach Yahoo");
        return;
      }

      // 2. Cache hit
      const cached = getCached();
      if (cached) {
        renderTeamsInto(cached.teams);
        setStatus(`Live data · ${secondsAgo(cached.ts)}s ago`, "ok");
        return;
      }

      // 3. Resolve league_key
      setStatus("Loading Yahoo data…", "loading");
      let leagueKey: string;
      try {
        leagueKey = await resolveLeagueKey();
      } catch {
        setStatus("League lookup failed", "err");
        renderGenericError("Couldn't find Tinez league in your Yahoo account");
        return;
      }

      // 4. Fetch 2025 draft + current roster IN PARALLEL
      let drafts: any[] = [];
      let rosters: any[] = [];
      try {
        [drafts, rosters] = await Promise.all([
          getDraftResults(leagueKey, ELIGIBILITY_SEASON),
          getRosters(leagueKey),
        ]);
      } catch (e: any) {
        if (e instanceof YahooAuthError) {
          setStatus("Yahoo session expired", "err");
          renderAuthError();
        } else if (e instanceof YahooRateLimitError) {
          setStatus("Yahoo rate limited", "err");
          renderGenericError("Rate limited by Yahoo — try again in a minute");
        } else {
          setStatus("Yahoo data fetch failed", "err");
          renderGenericError("Couldn't load Yahoo data");
        }
        return;
      }

      if (!drafts || drafts.length === 0) {
        setStatus("No draft data", "err");
        renderGenericError(`Yahoo returned no ${ELIGIBILITY_SEASON} draft results`);
        return;
      }
      if (!rosters || rosters.length === 0) {
        setStatus("No roster data", "err");
        renderGenericError("Yahoo returned no current rosters");
        return;
      }

      // 5. Compute eligibility
      const teams = buildKeeperEligibility(drafts, rosters);
      setCached(teams);
      renderTeamsInto(teams);
      setStatus(`Live data · just now (${drafts.length} picks scanned)`, "ok");
    }

    // requestIdleCallback polyfill (Safari doesn't ship it)
    const ric: (cb: () => void) => void =
      (window as any).requestIdleCallback ||
      ((cb: () => void) => setTimeout(cb, 1));

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => ric(() => run()));
    } else {
      ric(() => run());
    }
  </script>

  <!-- Keeper Strategy Tips -->
  <div class="mt-8 glass-card rounded-xl p-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="text-lg">💡</span>
      <h2 class="text-lg font-bold text-zinc-100">Keeper Strategy</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="bg-zinc-800/30 rounded-lg p-4">
        <h3 class="text-sm font-bold text-emerald-400 mb-2">Best Keeper Values</h3>
        <ul class="space-y-1.5 text-xs text-zinc-400">
          <li>• Late-round RBs who became starters (e.g., 12th round → 11th round cost)</li>
          <li>• Breakout WRs drafted in double-digit rounds</li>
          <li>• Rookies who outperformed their ADP</li>
          <li>• Players returning from injury with discounted cost</li>
        </ul>
      </div>
      <div class="bg-zinc-800/30 rounded-lg p-4">
        <h3 class="text-sm font-bold text-red-400 mb-2">When NOT to Keep</h3>
        <ul class="space-y-1.5 text-xs text-zinc-400">
          <li>• First-round picks (no discount, same value in draft)</li>
          <li>• Aging stars with declining production</li>
          <li>• Players in timeshares or uncertain roles</li>
          <li>• When you can get equal value in the same round</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
