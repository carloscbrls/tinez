---
import Layout from "../layouts/Layout.astro";
import { teams } from "../data/teams";
import { teamRosters, getKeeperSummary } from "../data/keepers";
---

<Layout title="Keepers">
  <div class="mb-8">
    <div class="relative overflow-hidden rounded-2xl border border-amber-500/20">
      <div class="hero-gradient absolute inset-0 animate-gradient"></div>
      <div class="relative z-10 p-8">
        <div class="flex items-center gap-3 mb-2">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 text-lg font-bold text-white shadow-lg shadow-amber-500/20">🔄</div>
          <div>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">
              <span class="gradient-text">Keeper Tracker</span>
            </h1>
            <p class="text-zinc-400 text-sm mt-0.5">TINEZ LEAGUE · 2026 Season · Keeper (1+1) Format</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2025 Final Standings -->
  <div class="glass-card-accent rounded-xl p-5 mb-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-lg">🏆</span>
      <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider">2025 Season Results</h2>
    </div>
    <div class="grid gap-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="text-yellow-400">🥇</span>
        <span class="text-zinc-200 font-semibold">Best Pacheco Hoe</span>
        <span class="text-zinc-500">(jayyphilly) — Champion</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-zinc-400">🥈</span>
        <span class="text-zinc-200 font-semibold">The Red Hare & Golden Dragon</span>
        <span class="text-zinc-500">(darnell) — 2nd Place</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-amber-700">🥉</span>
        <span class="text-zinc-200 font-semibold">LaFlamaBlanca</span>
        <span class="text-zinc-500">(scooter) — 3rd Place</span>
      </div>
    </div>
  </div>

  <!-- Keeper Rules -->
  <div class="glass-card-accent rounded-xl p-5 mb-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-lg">📋</span>
      <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider">Keeper Rules</h2>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 text-xs text-zinc-400">
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Each team keeps <strong class="text-zinc-200">1 player + 1 rookie</strong> from previous season</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Keepers cost <strong class="text-zinc-200">1 round higher</strong> than previous draft position</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Undrafted players kept as <strong class="text-zinc-200">15th round</strong> pick</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Rookies kept as <strong class="text-zinc-200">16th round</strong> pick (separate from main keeper)</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Players kept <strong class="text-zinc-200">max 2 consecutive years</strong> before returning to pool</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-emerald-400 mt-0.5">•</span>
        <span>Keeper deadline: <strong class="text-zinc-200">1 week before draft</strong></span>
      </div>
    </div>
  </div>

  <!-- Team Keeper Cards -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 stagger-children" id="keepers-grid">
    {teamRosters.map((roster, idx) => {
      const { kept } = getKeeperSummary(roster.teamName);
      return (
        <div class="glass-card rounded-xl overflow-hidden" data-team-name={roster.teamName}>
          <div class="bg-gradient-to-r from-amber-500/10 to-orange-500/5 p-4 border-b border-zinc-800/40">
            <h3 class="text-sm font-bold text-zinc-100">{roster.teamName}</h3>
            <p class="text-[10px] text-zinc-500">{roster.manager}</p>
          </div>
          <div class="p-4">
            <!-- Previously Kept Players (static, from 2025 final rosters) -->
            {kept.length > 0 && (
              <div class="mb-3">
                <h4 class="text-[10px] font-semibold text-amber-400 uppercase tracking-wider mb-2">Previously Kept (2025)</h4>
                <div class="space-y-1.5">
                  {kept.map(p => (
                    <div class="flex items-center justify-between bg-amber-500/5 rounded-lg px-2.5 py-1.5">
                      <div class="flex items-center gap-1.5">
                        <span class="text-xs">🔒</span>
                        <span class="text-xs font-medium text-zinc-200">{p.name}</span>
                        <span class="text-[10px] text-zinc-500">{p.position} · {p.nflTeam}</span>
                      </div>
                      <span class="text-[10px] text-amber-400 font-mono">Rd {p.draftRound}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {kept.length === 0 && (
              <div class="text-center py-4">
                <p class="text-xs text-zinc-600">No locks from 2025</p>
              </div>
            )}

            <!-- Live Current Roster (Yahoo, fetched client-side) -->
            <div data-eligible-slot={idx}>
              <h4 class="text-[10px] font-semibold text-emerald-400 uppercase tracking-wider mb-2 mt-1">
                Current Roster <span class="text-zinc-600 normal-case font-normal">(live from Yahoo)</span>
              </h4>
              <div class="space-y-1 max-h-48 overflow-y-auto" data-eligible-list>
                <!-- Skeleton while loading -->
                <div data-eligible-loading class="space-y-1">
                  <div class="h-4 bg-zinc-800/50 rounded animate-pulse"></div>
                  <div class="h-4 bg-zinc-800/50 rounded animate-pulse w-11/12"></div>
                  <div class="h-4 bg-zinc-800/50 rounded animate-pulse w-10/12"></div>
                </div>
              </div>
              <!-- Error/Auth state gets injected here by the script -->
              <div data-eligible-error class="hidden"></div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Live data status footer -->
  <div id="keepers-live-status" class="mt-4 flex items-center justify-end gap-2 text-[10px] text-zinc-600">
    <span class="h-1.5 w-1.5 rounded-full bg-zinc-700" id="keepers-live-dot"></span>
    <span id="keepers-live-label">Live data idle</span>
  </div>

  <!-- Client-side Yahoo roster fetch -->
  <script>
    import { checkAuth, getLeagues, getRosters, YahooAuthError, YahooRateLimitError } from "../data/yahoo-api";

    // Tinez league — if /leagues lookup fails we fall back to this hardcoded key.
    const TINEZ_LEAGUE_ID = "541137";
    const TINEZ_LEAGUE_KEY = "449.l.541137";
    const SESSION_TTL_MS = 5 * 60 * 1000;

    type SlotEl = HTMLDivElement;
    type LivePlayer = {
      name: string;
      position: string;
      nflTeam: string;
      injuryStatus?: string;
    };
    type LiveRoster = {
      teamName: string;
      manager: string;
      players: LivePlayer[];
    };

    function setStatus(text: string, dot: "idle" | "loading" | "ok" | "err" = "idle") {
      const label = document.getElementById("keepers-live-label");
      const dotEl = document.getElementById("keepers-live-dot");
      if (label) label.textContent = text;
      if (dotEl) {
        dotEl.className =
          "h-1.5 w-1.5 rounded-full " +
          (dot === "ok" ? "bg-emerald-400" :
           dot === "loading" ? "bg-amber-400 animate-pulse" :
           dot === "err" ? "bg-red-400" : "bg-zinc-700");
      }
    }

    function getCachedRosters(): { rosters: LiveRoster[]; ts: number } | null {
      try {
        const raw = sessionStorage.getItem("tinez:keepers:v1");
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed?.ts || !parsed?.rosters) return null;
        if (Date.now() - parsed.ts > SESSION_TTL_MS) return null;
        return { rosters: parsed.rosters as LiveRoster[], ts: parsed.ts };
      } catch { return null; }
    }
    function setCachedRosters(rosters: LiveRoster[]) {
      try {
        sessionStorage.setItem("tinez:keepers:v1", JSON.stringify({ ts: Date.now(), rosters }));
      } catch {}
    }

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, c => (
        { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!
      ));
    }

    function secondsAgo(ts: number): number {
      return Math.max(0, Math.round((Date.now() - ts) / 1000));
    }

    function playerRowHtml(p: LivePlayer): string {
      // Yahoo's /rosters endpoint doesn't return draft_round or keeper_status,
      // so we show name + position + team + injury status. Round/cost math
      // would be misleading without that data.
      const injuryBadge = p.injuryStatus
        ? `<span class="text-[10px] text-red-400 shrink-0">${escapeHtml(p.injuryStatus)}</span>`
        : "";
      return `
        <div class="flex items-center justify-between px-2.5 py-1 hover:bg-zinc-800/30 rounded-lg transition-colors">
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-xs text-zinc-200 truncate">${escapeHtml(p.name)}</span>
            <span class="text-[10px] text-zinc-500 shrink-0">${escapeHtml(p.position)} · ${escapeHtml(p.nflTeam)}</span>
            ${injuryBadge}
          </div>
        </div>`;
    }

    function renderRostersInto(rosters: LiveRoster[]) {
      const cards = document.querySelectorAll<HTMLElement>("[data-team-name]");
      cards.forEach(card => {
        const teamName = card.dataset.teamName || "";
        const slot = card.querySelector<SlotEl>("[data-eligible-list]");
        if (!slot) return;
        // Try exact match first, then fuzzy (Yahoo sometimes adds "(...)" suffixes)
        let roster = rosters.find(r => r.teamName === teamName);
        if (!roster) {
          roster = rosters.find(r => r.teamName.startsWith(teamName));
        }
        if (!roster || !roster.players || roster.players.length === 0) {
          slot.innerHTML = `<p class="text-[10px] text-zinc-600 py-2">No roster data for this team.</p>`;
          return;
        }
        slot.innerHTML = roster.players.map(playerRowHtml).join("");
      });
    }

    function renderAuthError() {
      const slots = document.querySelectorAll<HTMLElement>("[data-eligible-list]");
      slots.forEach(s => {
        s.innerHTML = `
          <div class="text-center py-4">
            <p class="text-xs text-zinc-400 mb-2">Connect Yahoo to see live current rosters.</p>
            <a href="/connect-yahoo" class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-br from-amber-400 to-orange-500 px-3 py-1.5 text-xs font-semibold text-white shadow-lg shadow-amber-500/20 hover:scale-105 transition-transform">
              Connect Yahoo →
            </a>
          </div>`;
      });
      // Hide loading skeletons
      document.querySelectorAll<HTMLElement>("[data-eligible-loading]").forEach(el => el.remove());
    }

    function renderGenericError(msg: string) {
      const slots = document.querySelectorAll<HTMLElement>("[data-eligible-list]");
      slots.forEach(s => {
        s.innerHTML = `
          <div class="text-center py-3">
            <p class="text-xs text-zinc-500">⚠️ ${escapeHtml(msg)}</p>
            <button data-retry class="mt-2 text-[10px] text-amber-400 hover:text-amber-300 underline">Retry</button>
          </div>`;
      });
      document.querySelectorAll<HTMLElement>("[data-eligible-loading]").forEach(el => el.remove());
      document.querySelectorAll<HTMLElement>("[data-retry]").forEach(b => b.addEventListener("click", () => run()));
    }

    // Look up the league_key from /leagues (handles the case where the
    // hardcoded key is stale because Yahoo's game_id changed or similar).
    async function resolveLeagueKey(): Promise<string> {
      try {
        const leagues = await getLeagues();
        const match = leagues.find(l => l.league_id === TINEZ_LEAGUE_ID);
        if (match?.league_key) return match.league_key;
      } catch {}
      return TINEZ_LEAGUE_KEY;
    }

    function yahooRosterToLive(rosters: any[]): LiveRoster[] {
      return rosters.map(r => ({
        teamName: r.team_name || "",
        manager: "",
        players: (r.players || []).map((p: any) => ({
          name: p.name?.full || "",
          position: p.display_position || "",
          nflTeam: p.editorial_team || "",
          // Show "Q", "O", "IR", "D" etc. when Yahoo tags the player
          injuryStatus: p.status && p.status !== "Healthy" && p.status !== "ACTIVE"
            ? p.status
            : undefined,
        })),
      }));
    }

    async function run() {
      const cards = document.querySelectorAll("[data-team-name]");
      if (cards.length === 0) return; // page not in expected shape

      // 1. Check auth first — fast fail with a clear CTA.
      try {
        const auth = await checkAuth();
        if (!auth.authenticated) {
          setStatus("Yahoo not connected", "err");
          renderAuthError();
          return;
        }
      } catch {
        setStatus("Yahoo status check failed", "err");
        renderGenericError("Couldn't reach Yahoo");
        return;
      }

      // 2. Cache hit?
      const cached = getCachedRosters();
      if (cached) {
        renderRostersInto(cached.rosters);
        setStatus(`Live data · ${secondsAgo(cached.ts)}s ago`, "ok");
        return;
      }

      // 3. Resolve league_key (handles stale hardcoded fallback)
      setStatus("Loading Yahoo rosters…", "loading");
      let leagueKey: string;
      try {
        leagueKey = await resolveLeagueKey();
      } catch {
        setStatus("League lookup failed", "err");
        renderGenericError("Couldn't find Tinez league in your Yahoo account");
        return;
      }

      // 4. Fetch rosters
      let rosters: any[];
      try {
        rosters = await getRosters(leagueKey);
      } catch (e: any) {
        if (e instanceof YahooAuthError) {
          setStatus("Yahoo session expired", "err");
          renderAuthError();
        } else if (e instanceof YahooRateLimitError) {
          setStatus("Yahoo rate limited", "err");
          renderGenericError("Rate limited by Yahoo — try again in a minute");
        } else {
          setStatus("Yahoo roster fetch failed", "err");
          renderGenericError("Couldn't load rosters");
        }
        return;
      }

      if (!rosters || rosters.length === 0) {
        setStatus("No rosters returned", "err");
        renderGenericError("Yahoo returned no rosters for this league");
        return;
      }

      const live = yahooRosterToLive(rosters);
      setCachedRosters(live);
      renderRostersInto(live);
      setStatus("Live data · just now", "ok");
    }

    // requestIdleCallback polyfill (Safari doesn't ship it)
    const ric: (cb: () => void) => void =
      (window as any).requestIdleCallback ||
      ((cb: () => void) => setTimeout(cb, 1));

    // Defer until idle / DOM ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => ric(() => run()));
    } else {
      ric(() => run());
    }
  </script>

  <!-- Keeper Strategy Tips -->
  <div class="mt-8 glass-card rounded-xl p-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="text-lg">💡</span>
      <h2 class="text-lg font-bold text-zinc-100">Keeper Strategy</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="bg-zinc-800/30 rounded-lg p-4">
        <h3 class="text-sm font-bold text-emerald-400 mb-2">Best Keeper Values</h3>
        <ul class="space-y-1.5 text-xs text-zinc-400">
          <li>• Late-round RBs who became starters (e.g., 12th round → 11th round cost)</li>
          <li>• Breakout WRs drafted in double-digit rounds</li>
          <li>• Rookies who outperformed their ADP</li>
          <li>• Players returning from injury with discounted cost</li>
        </ul>
      </div>
      <div class="bg-zinc-800/30 rounded-lg p-4">
        <h3 class="text-sm font-bold text-red-400 mb-2">When NOT to Keep</h3>
        <ul class="space-y-1.5 text-xs text-zinc-400">
          <li>• First-round picks (no discount, same value in draft)</li>
          <li>• Aging stars with declining production</li>
          <li>• Players in timeshares or uncertain roles</li>
          <li>• When you can get equal value in the same round</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
